{
  "name": "komixy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/ensure-deps.mjs",
    "test": "ng test",
    "deploy:dev": "npx vercel",
    "deploy:login": "npx vercel login",
    "deploy:prod": "npx vercel --prod",
    "prelint": "node scripts/ensure-deps.mjs",
    "lint": "eslint src && node scripts/check-specs.mjs && node scripts/check-class-order.mjs",
    "preknip": "node scripts/ensure-deps.mjs",
    "knip": "knip"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/tailwind.css",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/material-symbols": "^34.0.0",
    "@ng-icons/simple-icons": "^34.0.0",
    "qs": "^6.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qs": "^6.15.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "jsdom": "^27.1.0",
    "knip": "^6.44.1",
    "postcss": "^8.5.3",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  }
}
