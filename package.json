{
  "name": "komixy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy:dev": "npx vercel",
    "deploy:login": "npx vercel login",
    "deploy:prod": "npx vercel --prod",
    "lint": "eslint src && node scripts/check-specs.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource-variable/mulish": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/material-symbols": "^34.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  }
}
